# Copy to `.env`. Expo also reads `.env.local`.
#
# Hosted (typical):
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
#
# Local Docker instead: `npx supabase start`, then paste values from `npx supabase status`.
# Keep 127.0.0.1 - the app swaps it for your PC's LAN IP so Expo Go can reach it.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
